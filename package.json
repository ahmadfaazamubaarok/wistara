    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "seed:destinations": "tsx scripts/seed-destinations.ts",
    "seed:facilities": "tsx scripts/seed-facilities.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fontsource-variable/fraunces": "^5.3.0",
