    "maplibre-gl": "^6.14.0",
    "next": "^16.4.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
