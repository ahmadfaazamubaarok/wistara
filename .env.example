# Salin menjadi .env:
#   Linux/macOS : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
#
# Semua nilai OPSIONAL. Tanpa .env pun `docker compose up` berjalan memakai
# default yang sama dengan di bawah. .env tidak boleh di-commit.

# --- Port di host ---------------------------------------------------------
APP_PORT=3000
# 127.0.0.1 = hanya bisa dibuka dari komputer ini.
# Ganti ke 0.0.0.0 bila ingin menguji dari ponsel di jaringan yang sama
# (isi juga NEXT_ALLOWED_DEV_ORIGINS di bawah). Basis data selalu hanya lokal.
APP_BIND=127.0.0.1
DB_PORT=5432

# --- Basis data (khusus dev lokal, bukan kredensial produksi) -------------
# Hindari karakter @ : / # ? pada kata sandi, karena dipakai di DATABASE_URL.
POSTGRES_USER=wistara
POSTGRES_PASSWORD=wistara_dev
POSTGRES_DB=jelajahlokal

# --- UID/GID pengguna di dalam container ----------------------------------
# Hanya perlu diubah di Linux bila `id -u` bukan 1000. Setelah mengubah,
# jalankan `docker compose build`. Di Windows biarkan 1000.
DEV_UID=1000
DEV_GID=1000

# --- Konfigurasi aplikasi -------------------------------------------------
# URL style peta (desain: jangan ditulis langsung di kode agar mudah diganti).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Host yang boleh mengakses dev server selain localhost, pisahkan dengan koma.
# Contoh untuk uji dari ponsel: 192.168.1.23
NEXT_ALLOWED_DEV_ORIGINS=

# --- Cron pemanas cache (GET /api/cron/refresh) ----------------------------
# Di Vercel, isi CRON_SECRET (acak, minimal 16 karakter) di Environment Variables;
# Vercel mengirimnya sebagai "Authorization: Bearer <nilai>". Tanpa nilai, endpoint tertutup.
# Uji lokal: curl -H "Authorization: Bearer dev-only-cron-secret" http://localhost:3000/api/cron/refresh
CRON_SECRET=dev-only-cron-secret
# Ganti alamat API BMKG (mis. ke alamat yang salah) untuk menguji ketahanan saat BMKG gagal.
BMKG_API_BASE_URL=

# --- Akun uji lokal (hanya ada di database dev; dibuat lewat /masuk?mode=daftar) -------
# Email: penguji.lokal@contoh.test   Kata sandi: Uji-Rencana-2026!
# Konfirmasi email dimatikan di lokal (GOTRUE_MAILER_AUTOCONFIRM); di Supabase produksi tetap aktif.
